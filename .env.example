# ============================================================
# Farmacia César — plantilla de variables de entorno
# Copia este archivo a .env y completa los valores.
# TODO: Configurar con las credenciales del NUEVO proyecto Supabase.
# Sin estas variables la app funciona 100% offline (modo local).
# ============================================================

# --- Supabase (obligatorio para sincronización entre sedes) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- IA opcional (puede quedar vacío) ---
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_SECONDARY=

# --- Licencias (obsoleto — se mantiene por compatibilidad) ---
VITE_LICENSE_SALT=
