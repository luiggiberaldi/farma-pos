# ============================================================
# Farma POS — plantilla de variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Los archivos .env* están ignorados por Git.
# ============================================================

# --- Supabase público: puede llegar al navegador ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos antiguos; preferir PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=

# --- Solo backend/local QA: nunca usar VITE_ ni exponer al navegador ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_CREATE_TEST_ADMIN=0

# --- IA opcional ---
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_SECONDARY=

# --- Licencias (compatibilidad) ---
VITE_LICENSE_SALT=
